# Configuration du bot InverseBond V2 (Sherwood ROBIN V2).
# A copier en /opt/robin-bot-v2/.env sur le VPS.
#
# IMPORTANT: utilise une CLE DIFFERENTE de celle du bot V1. Deux bots qui
# partagent la meme cle se marchent dessus sur les nonces et echouent tous les deux.

# Cle du wallet qui detient les ROBIN V2 (jamais commitee)
PRIVATE_KEY=

# Reseau
RPC_URL=https://rpc.mainnet.chain.robinhood.com
SEQUENCER_URL=https://sequencer.mainnet.chain.robinhood.com
NETWORK_LABEL=V2

# --- ADRESSES V2 (c'est ce qui distingue cette instance de la V1) ---
INVERSE_BOND_ADDRESS=0xCe4FDa6De3D3D9B763856a0c93785ED98A1b58a1
TREASURY_ADDRESS=0x70d39473CD3342B75C57465aE32a0a427d537654
ORACLE_ADDRESS=0xEa6a4F0F82163bcB3B0b71F94404c1d4122d3F45
ROBIN_ADDRESS=0x7219Bae4a491F1D922e499B568ca1c7Dd483887A

# true = simulation, aucune transaction envoyee. Passe a false quand tu es pret.
DRY_RUN=true

# Plancher de prix en USDG par ROBIN. Le backing V2 est ~4.47, le prix de rachat
# ~4.40. Mets 0 pour desactiver, ou ~3.5 pour refuser de vendre trop bas.
MIN_PRICE_USDG=0

# 0 = illimite
MAX_ROBIN_PER_TX=0

SLIPPAGE_BPS=50
POLL_MS=3000
POLL_FAST_MS=150
KEEP_ORACLE_ALIVE=false

# --- MODE SNIPE (tir pre-signe sur les bornes d'epoch) ---
SNIPE=true

# Echelle calibree sur la capacite V2 REELLE (~77 USDG = ~17.6 ROBIN par borne),
# bien plus petite qu'en V1. Le premier palier doit rester SOUS la capacite,
# sinon il revert meme en arrivant premier.
SNIPE_LADDER_ROBIN=15,10,6,3

SNIPE_PRESIGN_MS=1200
SNIPE_OFFSET_MS=30

# ATTENTION: maxFee = gasLimit(400000) x (base x FEE_MULT + PRIORITY_GWEI).
# Le noeud exige de couvrir ce montant max PAR TRANCHE, meme si tu ne paies que
# la base fee. Un tip trop eleve fait rejeter les tx a l'envoi (vecu en V1).
SNIPE_FEE_MULT=3
SNIPE_PRIORITY_GWEI=0

SNIPE_MOPUP_MS=8000
SNIPE_MIN_ZERO=false
SNIPE_USE_RPC_CLOCK=false
