# Copiez ce fichier: cp .env.example .env — puis remplissez PRIVATE_KEY vous-même.
# NE COMMITEZ JAMAIS .env (déjà dans .gitignore).

# Clé privée (0x...) du wallet qui détient les ROBIN. Vide => DRY_RUN forcé avec wallet factice.
PRIVATE_KEY=

# RPC Robinhood Chain mainnet (chainId 4663) — utilisé pour LIRE la chaîne
RPC_URL=https://rpc.mainnet.chain.robinhood.com

# Endpoint séquenceur DIRECT — utilisé pour DIFFUSER les tx (sans Cloudflare, plus rapide).
# Le séquenceur est en AWS us-east-2 (Ohio): pour vraiment être compétitif au 1er bloc,
# fais tourner ce bot sur un VPS us-east-2 (latence ~1-5 ms au lieu de ~270 ms depuis chez toi).
SEQUENCER_URL=https://sequencer.mainnet.chain.robinhood.com

# true = simulation: tout est calculé et loggé, aucune transaction envoyée
DRY_RUN=true

# Prix plancher en USDG par ROBIN (ex: 0.75). 0 = pas de plancher.
MIN_PRICE_USDG=0

# Quantité max de ROBIN par transaction (ex: 5000). 0 = illimité.
MAX_ROBIN_PER_TX=0

# Marge appliquée à minUsdgRaw, en basis points (50 = 0,50 %)
SLIPPAGE_BPS=50

# Cadence de polling normale (ms)
POLL_MS=3000

# Cadence rapide (ms), active de T-20 s à T+5 s autour d'un changement d'epoch
POLL_FAST_MS=400

# true = envoie oracle.checkpoint() quand le TWAP est indisponible (transaction => coûte du gas)
KEEP_ORACLE_ALIVE=false

# ============================================================================
# MODE SNIPE (optionnel) — transactions PRÉ-SIGNÉES tirées par minuterie à la
# seconde exacte de la borne d'epoch, sans lecture préalable, pour viser le
# TOUT PREMIER bloc de la nouvelle epoch (là où la capacité se renouvelle).
#
# IMPORTANT sur cette chaîne (Arbitrum Orbit): l'ordre des tx dans un bloc suit
# l'ORDRE D'ARRIVÉE au séquenceur, PAS le prix du gas. Monter les fees n'aide
# donc PAS à passer devant — seule la LATENCE compte. SNIPE_FEE_MULT ne sert
# qu'à garantir l'inclusion, pas à réordonner.
# ============================================================================

# Active le mode sniper (le polling continue en parallèle pour nettoyer les restes)
SNIPE=false

# Échelle de montants (ROBIN), décroissante, une tx pré-signée par tranche.
# On ne connaît pas la capacité à l'avance: la 1re tranche qui "rentre" sous la
# capacité passe, les trop grosses revert (poussière de gas). Cale ces valeurs
# sur la capacité observée par epoch. Bornées par le solde et MAX_ROBIN_PER_TX.
SNIPE_LADDER_ROBIN=28,20,12,6

# Combien de temps AVANT la borne on pré-signe (ms). Marge pour signer sans stress.
SNIPE_PRESIGN_MS=1200

# Décalage du tir par rapport à la borne (ms). +30 = tire 30 ms APRÈS 00:00:00.
# Trop tôt (négatif) = risque d'atterrir dans le bloc d'AVANT (revert garanti).
# Trop tard = on perd la course. À affiner selon ta latence.
SNIPE_OFFSET_MS=30

# Multiplicateur des fees (juste pour l'inclusion, n'améliore PAS l'ordre ici).
SNIPE_FEE_MULT=2

# Durée après le tir pendant laquelle le polling nettoie la capacité restante (ms)
SNIPE_MOPUP_MS=8000

# minUsdgRaw = 0 sur les tx snipe (supprime une condition de revert). Le prix
# étant adossé au backing (stable), la protection de slippage est peu utile ici.
SNIPE_MIN_ZERO=false

# Applique le décalage d'horloge mesuré via le RPC (résolution ~1 s, grossier).
# Laisse false et garde l'horloge Windows synchronisée (w32tm) pour un timing fin.
SNIPE_USE_RPC_CLOCK=false
